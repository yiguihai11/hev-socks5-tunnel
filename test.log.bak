========== tproxy.conf ==========
tunnel:
  mtu: 1500
socks5:
  tcp:
    port: 1080
    address: '64.69.34.166'
    username: 'yiguihai'
    password: 'ygh15177542493'
  udp:
    address: '64.69.34.166'
    port: 1080
    udp-relay: 'udp'
    username: 'yiguihai'
    password: 'ygh15177542493'
dns-split-tunnel:
  enabled: true
  foreign-dns:
    - "1.1.1.1"
    - "8.8.8.8"
    - "2606:4700:4700::1111"
    - "2001:4860:4860::8888"
dns-forwarder:
  enabled: false
mapdns:
  address: 198.18.0.2
  address6: 'fd00::1'
  port: 53
  network: 240.0.0.0
  netmask: 240.0.0.0
  network6: 'fd00::'
  prefixlen: 96
  cache-size: 10000
dns-latency-optimize:
  enabled: true
  timeout-ms: 250
smart-proxy:
  enabled: true
  timeout-ms: 1400
  blocked-ip-expiry-minutes: 360
  probe-ports:
    - 80
    - 443
chnroutes:
  enabled: true
  file-path: "/data/user/0/hev.sockstun/cache/chnroutes.txt"
acl:
  enabled: true
  file-path: "/data/user/0/hev.sockstun/cache/acl.txt"
misc:
  task-stack-size: 81920
  tcp-buffer-size: 65536
  udp-recv-buffer-size: 524288
  udp-copy-buffer-nums: 10
  connect-timeout: 10000
  tcp-read-write-timeout: 300000
  udp-read-write-timeout: 5000
  log-file: '/data/user/0/hev.sockstun/cache/tunnel.log'
  log-level: debug

========== End of Config ==========

