# hev-socks5-tunnel 零拷贝优化模块 Makefile 片段
#
# 将以下内容添加到主 Makefile 中以启用零拷贝优化

# 零拷贝优化源文件
ZERO_COPY_SOURCES = \
	hev-session-manager-zerocopy.c \
	hev-protocol-parser.c \
	hev-session-manager-optimized.c

# 零拷贝优化对象文件
ZERO_COPY_OBJECTS = $(ZERO_COPY_SOURCES:.c=.o)

# 添加到主构建系统
SOURCES += $(ZERO_COPY_SOURCES)
OBJECTS += $(ZERO_COPY_OBJECTS)

# 零拷贝优化编译标志
ZERO_COPY_CFLAGS = \
	-DENABLE_ZERO_COPY=1 \
	-DENABLE_BATCH_UDP=1 \
	-DENABLE_PROTOCOL_PARSER=1

# 检查系统是否支持所需的系统调用
CHECK_ZERO_COPY_SUPPORT = \
	$(shell grep -qs 'recvmmsg' /usr/include/sys/socket.h && echo "1" || echo "0")

# 根据系统支持调整编译选项
ifeq ($(CHECK_ZERO_COPY_SUPPORT),1)
	ZERO_COPY_CFLAGS += -DHAS_RECVMMSG=1
	$(info Found recvmmsg support, enabling batch UDP optimization)
else
	$(warning recvmmsg not found, batch UDP optimization disabled)
endif

# 添加编译标志到主编译器标志
CFLAGS += $(ZERO_COPY_CFLAGS)

# 零拷贝优化特定依赖
hev-session-manager-zerocopy.o: hev-session-manager-zerocopy.c hev-session-manager-zerocopy.h
	$(CC) $(CFLAGS) -c $< -o $@

hev-protocol-parser.o: hev-protocol-parser.c hev-protocol-parser.h
	$(CC) $(CFLAGS) -c $< -o $@

hev-session-manager-optimized.o: hev-session-manager-optimized.c hev-session-manager-optimized.h
	$(CC) $(CFLAGS) -c $< -o $@

# 零拷贝优化测试目标
test-zerocopy: $(ZERO_COPY_OBJECTS)
	@echo "Building zero-copy optimization tests..."
	$(CC) $(CFLAGS) -DTEST_ZERO_COPY $(ZERO_COPY_SOURCES) test-zerocopy.c -o test-zerocopy -lpthread
	@echo "Running zero-copy optimization tests..."
	./test-zerocopy

# 性能基准测试
benchmark-zerocopy: $(ZERO_COPY_OBJECTS)
	@echo "Building zero-copy benchmark..."
	$(CC) $(CFLAGS) -DBENCHMARK_ZERO_COPY $(ZERO_COPY_SOURCES) benchmark-zerocopy.c -o benchmark-zerocopy -lpthread
	@echo "Running zero-copy benchmark..."
	./benchmark-zerocopy

# 安装零拷贝优化头文件
install-zerocopy-headers:
	install -d $(DESTDIR)$(includedir)/hev-socks5-tunnel
	install -m 644 hev-session-manager-zerocopy.h $(DESTDIR)$(includedir)/hev-socks5-tunnel/
	install -m 644 hev-protocol-parser.h $(DESTDIR)$(includedir)/hev-socks5-tunnel/
	install -m 644 hev-session-manager-optimized.h $(DESTDIR)$(includedir)/hev-socks5-tunnel/

# 清理零拷贝优化文件
clean-zerocopy:
	rm -f $(ZERO_COPY_OBJECTS) test-zerocopy benchmark-zerocopy

# 帮助信息
help-zerocopy:
	@echo "Zero-Copy Optimization Build Targets:"
	@echo "  test-zerocopy          - Build and run zero-copy tests"
	@echo "  benchmark-zerocopy     - Build and run performance benchmarks"
	@echo "  install-zerocopy-headers - Install zero-copy header files"
	@echo "  clean-zerocopy         - Clean zero-copy build files"
	@echo "  help-zerocopy          - Show this help message"

.PHONY: test-zerocopy benchmark-zerocopy install-zerocopy-headers clean-zerocopy help-zerocopy